                "type": "text",
              },
            ],
            "details": "54 ans",
            "id": "g2.6",
            "name": "Dr Marcus Harrington",
          },
          {
            "description": [
              {
                "text": "Mariés depuis cinquante ans.",
                "type": "text",
              },
            ],
            "details": "",
            "id": "g2.7",
            "name": "Lord Reginald et Lady Monica Fairfax",
          },
          {
            "description": [
              {
                "text": "Industriel, baronnet récent.",
                "type": "text",
              },
            ],
            "details": "52 ans",
            "id": "g2.8",
            "name": "Sir Edmund Blackstone",
          },
          {
            "description": [
              {
                "text": "Épouse d’un mari « en voyage ».",
                "type": "text",
              },
            ],
            "details": "35 ans",
            "id": "g2.9",
            "name": "Béatrice Prévost",
          },
          {
            "description": [
              {
                "text": "Technicien en télégraphie, son compagnon.",
                "type": "text",
              },
            ],
            "details": "32 ans",
            "id": "g2.10",
            "name": "Thomas Davies",
          },
          {
            "description": [
              {
                "text": "Épouse du pianiste Théodore Eristoff.",
                "type": "text",
              },
            ],
            "details": "",
            "id": "g2.11",
            "name": "Lady Elizabeth « Lily » Eristoff",
          },
          {
            "description": [
              {
                "text": "Veuve du compositeur Giuseppe Valentini.",
                "type": "text",
