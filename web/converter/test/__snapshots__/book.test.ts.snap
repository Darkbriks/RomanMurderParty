              {
                "text": "Danseuse et chorégraphe.",
                "type": "text",
              },
            ],
            "details": "34 ans",
            "id": "g2.3",
            "name": "Ophelia Beaumont",
          },
          {
            "description": [
              {
                "text": "Journaliste d’investigation.",
                "type": "text",
